(import (chezscheme) (process))

(define c-bench (car (command-line-arguments)))
(define spawn-count 2000)
(define byte-count (* 1024 1024 1024))
(define pty-byte-count (* 256 1024 1024))

(define (elapsed thunk)
  (let ([start (current-time 'time-monotonic)])
    (thunk)
    (let ([d (time-difference (current-time 'time-monotonic) start)])
      (+ (time-second d) (/ (time-nanosecond d) 1e9)))))

(define (drain port)
  (let ([buffer (make-bytevector 65536)])
    (let loop ([total 0])
      (let ([n (get-bytevector-some! port buffer 0 65536)])
        (if (eof-object? n) total (loop (+ total n)))))))

(define null-stdio (process-options [stdin 'null] [stdout 'null] [stderr 'null]))

(define (c-results arguments)
  (let ([r (run-process c-bench (map number->string arguments))])
    (unless (exit-status-success? (process-result-status r))
      (errorf 'bench "~a failed: ~a" c-bench (utf8->string (process-result-stderr r))))
    (let ([port (open-input-string (utf8->string (process-result-stdout r)))])
      (let loop ([acc '()])
        (let ([line (get-line port)])
          (if (eof-object? line)
              acc
              (let ([fields (read (open-input-string (string-append "(" line ")")))])
                (loop (cons fields acc)))))))))

(define (row label c scheme unit)
  (printf "  ~38a ~12,2f ~12,2f ~8,2f  ~a\n" label c scheme (/ scheme c) unit))

(printf "chez-process benchmark\n\n")
(do ([i 0 (+ i 1)]) ((= i 100)) (process-wait (spawn-process "/bin/true" '() null-stdio)))
(let* ([c (c-results (list spawn-count byte-count pty-byte-count))]
       [c-time (lambda (key) (cdr (assq key c)))]
       [megabytes (/ byte-count 1e6)]
       [pty-megabytes (/ pty-byte-count 1e6)])
  (printf "  ~38a ~12a ~12a ~8a\n" "" "C" "Scheme" "ratio")
  (row "spawn and wait /bin/true, stdio null, us" (* 1e6 (car (c-time 'spawn-null)))
    (* 1e6 (/ (elapsed (lambda ()
                         (do ([i 0 (+ i 1)]) ((= i spawn-count))
                           (process-wait (spawn-process "/bin/true" '() null-stdio)))))
              spawn-count))
    "")
  (row "spawn and wait /bin/true, stdio pipes, us" (* 1e6 (car (c-time 'spawn-pipes)))
    (* 1e6 (/ (elapsed (lambda ()
                         (do ([i 0 (+ i 1)]) ((= i spawn-count))
                           (let ([p (spawn-process "/bin/true" '())])
                             (drain (process-stdout p))
                             (process-wait p)
                             (close-port (process-stdin p))
                             (close-port (process-stdout p))
                             (close-port (process-stderr p))))))
              spawn-count))
    "")
  (let ([n 200])
    (row "Chez open-process-ports \"exec true\", us" (* 1e6 (car (c-time 'spawn-pipes)))
      (* 1e6 (/ (elapsed (lambda ()
                           (do ([i 0 (+ i 1)]) ((= i n))
                             (let-values ([(to from errors pid)
                                           (open-process-ports "exec /bin/true")])
                               (close-port to)
                               (get-bytevector-all from)
                               (close-port from)
                               (close-port errors)))))
                n))
      "status lost to the collector"))
  (row "read a pipe, MB/s" (/ megabytes (car (c-time 'pipe)))
    (/ megabytes
       (elapsed (lambda ()
                  (let ([p (spawn-process "head" (list "-c" (number->string byte-count) "/dev/zero")
                             (process-options [stdin 'null] [stderr 'null]))])
                    (unless (= byte-count (drain (process-stdout p))) (errorf 'bench "short read"))
                    (process-wait p)))))
    "1 GiB")
  (row "read a pty, MB/s" (/ pty-megabytes (car (c-time 'pty)))
    (/ pty-megabytes
       (elapsed (lambda ()
                  (let* ([pty (open-pty 24 80)]
                         [p (spawn-process "head" (list "-c" (number->string pty-byte-count) "/dev/zero")
                              (process-options [pty pty]))])
                    (unless (= pty-byte-count (drain (pty-input-port pty))) (errorf 'bench "short read"))
                    (process-wait p)
                    (pty-close! pty)))))
    "256 MiB")
  (let ([seconds (elapsed (lambda ()
                            (let ([r (run-process "head" (list "-c" (number->string byte-count) "/dev/zero"))])
                              (unless (= byte-count (bytevector-length (process-result-stdout r)))
                                (errorf 'bench "short capture")))))])
    (row "run-process capturing stdout, MB/s" (/ megabytes (car (c-time 'pipe))) (/ megabytes seconds)
      "1 GiB into one bytevector"))
  (let ([seconds (elapsed (lambda ()
                            (for-each process-wait
                              (map (lambda (i) (spawn-process "/bin/true" '() null-stdio)) (iota 200)))))])
    (printf "  ~38a ~12a ~12,2f\n" "200 concurrent spawns, then 200 waits, ms" "" (* 1e3 seconds))))
